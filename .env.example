# ---------------------------------------------------------------------------
# Vinhomes Platinum Living — environment variables
# Copy to `.env.local` and fill in. All values are OPTIONAL for local dev;
# the site runs fully without them and acknowledges enquiries gracefully.
# ---------------------------------------------------------------------------

# Public base URL used for canonical links / metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://vinhomesplatinumliving.com

# Email notification provider (Resend / SendGrid / SMTP)
# Wire these into app/api/enquiry/route.ts
EMAIL_API_KEY=
EMAIL_FROM=no-reply@vinhomesplatinum.com
EMAIL_TO=info@vinhomesplatinum.com

# CRM / WhatsApp Business Cloud API
WHATSAPP_TOKEN=
CRM_WEBHOOK_URL=

# Analytics (e.g. GA4 measurement id, injected via analytics integration)
NEXT_PUBLIC_GA_ID=
